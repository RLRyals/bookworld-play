  "triggers": [
    {
      "id": "village-entry",
      "label": "Everbrook Square",
      "mode": "auto",
      "once": true,
      "shape": "radius",
      "position": [0, 0, -12],
      "radius": 4,
      "srHint": "The square opens ahead: cottages, a well, and the sound of the brook.",
      "trigger": { "type": "cutscene", "cutsceneId": "village-arrival" }
    },
    {
      "id": "the-well",
      "label": "The Well",
      "mode": "prompted",
      "once": false,
      "shape": "radius",
      "anchor": "well-base",
      "offset": [0, -0.5, 0],
      "radius": 2.6,
      "prompt": "Press E to look at the well",
      "srHint": "A stone well at the centre of the square, its little roof throwing a triangle of shade.",
      "trigger": {
        "type": "prose",
        "text": "The rope is worn smooth where a hundred hands have gripped it before yours. Somewhere below, water breathes back a small, cool echo. It smells like stone and moss and the particular quiet of a well that everyone in Everbrook has drunk from at least once."
      }
    },
    {
      "id": "market-stalls",
      "label": "The Market Stalls",
      "mode": "prompted",
      "once": false,
      "shape": "box",
      "bounds": [6, 3, 6],
      "position": [6, 0, 1],
      "prompt": "Press E to look at the stalls",
      "srHint": "Two market stalls with striped canopies, empty for the evening.",
      "trigger": {
        "type": "prose",
        "text": "The stalls are packed up for the night, canvas canopies still holding the last warm light like they're reluctant to let go of it. Someone has left a crate of unsold apples by the near table, half covered with a cloth, for morning."
      }
    },
    {
      "id": "the-brook",
      "label": "The Brook",
      "mode": "prompted",
      "once": false,
      "shape": "box",
      "bounds": [4, 3, 10],
      "position": [13, 0, -6],
      "prompt": "Press E to listen to the brook",
      "srHint": "A shallow brook runs along the eastern edge of the square.",
      "trigger": {
        "type": "prose",
        "text": "It isn't much of a brook — a few feet across, barely a hand deep — but it never stops talking. Gold light sits on top of it in broken coins, and somewhere under that it's cold enough to numb your fingers in ten seconds flat."
      }
    }
  ],
  "cutscenes": [
    {
      "id": "village-arrival",
      "title": "Arrival at Everbrook",
      "video": "../../scenes/manifest-a/cutscene.mp4",
      "poster": null
    }
  ],
