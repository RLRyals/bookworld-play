      ],
      "radius": 1.2,
      "prompt": "Press E — Bathroom",
      "srHint": "The bathroom fills the southeast quadrant.",
      "trigger": {
        "type": "prose",
        "text": "BATH (SE quadrant): sink on the east wall, toilet, shower in the southeast corner. The LAUNDRY closet (washer + dryer) sits between kitchen and bath — no opening to the kitchen (solid wall); its door is on the hallway side (both rulings Rebecca 2026-08-20)."
      }
    },
    {
