    {
      "id": "plaza-entry",
      "label": "The Plaza",
      "mode": "auto",
      "once": true,
      "shape": "radius",
      "position": [0, 0, 6],
      "radius": 3.0,
      "srHint": "A stone plaza opens ahead, colonnades on both sides.",
      "trigger": { "type": "cutscene", "cutsceneId": "plaza-arrival" }
    },
    {
      "id": "fountain",
      "label": "The Fountain",
      "mode": "prompted",
      "once": false,
      "shape": "radius",
      "anchor": "fountain-base",
      "offset": [0, -0.4, 0],
      "radius": 2.6,
      "prompt": "Press E to look at the fountain",
      "srHint": "A dry stone fountain plinth at the centre of the plaza.",
      "trigger": {
        "type": "prose",
        "text": "No water has run here in a long time. The basin is dry, dusted pale, and something — moss, maybe, or just shadow — has taken the low side of the rim."
      }
    },
    {
      "id": "brazier-chamber",
      "label": "The Brazier Chamber",
      "mode": "prompted",
      "once": false,
      "shape": "radius",
      "anchor": "brazier",
      "offset": [0, -0.9, 0],
      "radius": 2.2,
      "prompt": "Press E to approach the brazier",
      "srHint": "Through the archway: a small dark room with a single lit brazier.",
      "trigger": { "type": "cutscene", "cutsceneId": "brazier-light" }
    }
  ],
  "cutscenes": [
