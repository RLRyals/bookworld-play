{
  "id": "world-b-plaza",
  "title": "World B — Gray-box Plaza (differently shaped, placeholder)",
  "description": "A small stone plaza at dusk, gray-box placeholder geometry. Not a reskin of the street: a colonnade lines both long sides, a dry fountain plinth sits at the centre, and an archway on the north wall opens onto a small dark interior chamber with a lit brazier. Placeholder geometry only — no story canon. Authored entirely from the same geometry vocabulary as world-a (box / plane / emissiveQuad) with zero engine code changes.",
  "worldTexture": [
    "placeholder location — not tied to any story canon",
    "dusk, warm torchlight instead of neon, low clear haze",
    "an open plaza with a colonnade, not a street corridor",
    "no vehicles, no people — the plaza is empty"
  ],
  "spawn": {
    "position": [0, 0, 9],
    "yaw": 0.02,
    "pitch": -0.02
  },
  "player": {
    "eyeHeight": 1.65,
    "walkSpeed": 2.8,
    "radius": 0.45
  },
